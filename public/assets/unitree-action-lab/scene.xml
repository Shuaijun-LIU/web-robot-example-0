<mujoco model="unitree action lab">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" iterations="50"/>

  <statistic center="0 0 0.65" extent="2.6" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.32 0.32 0.32" specular="0.15 0.15 0.15"/>
    <rgba haze="0.15 0.18 0.22 1"/>
    <global azimuth="-125" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.38 0.42 0.47" rgb2="0.10 0.12 0.14" width="512" height="3072"/>
    <texture name="floor_tex" type="2d" builtin="checker" rgb1="0.34 0.35 0.36" rgb2="0.26 0.27 0.28" width="512" height="512"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="10 10" texuniform="true" reflectance="0.08"/>
    <model name="g1_dynamic" file="robots/g1/g1.xml"/>
    <model name="go2_arm_dynamic" file="robots/go2_arm/go2_with_arm.xml"/>
  </asset>

  <worldbody>
    <light name="key" pos="0 -2.5 4" dir="0 0.45 -1" directional="true" diffuse="0.85 0.83 0.78"/>
    <light name="fill" pos="0 3 2.5" dir="0 -1 -0.55" directional="true" diffuse="0.35 0.4 0.48"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="floor_mat" friction="1 0.01 0.001"/>
    <frame pos="-1.10 0 0">
      <attach model="g1_dynamic" body="pelvis" prefix="g1_"/>
    </frame>
    <frame pos="1.10 0 0">
      <attach model="go2_arm_dynamic" body="base" prefix="go2_"/>
    </frame>
  </worldbody>
</mujoco>
